{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coleta",
  "description": "Resposta de uma coleta (POST 201, GET por id 200, PUT 200)",
  "type": "object",
  "required": ["id", "empresaGeradora", "categoriaResiduo", "pesoKg", "dataAgendamento", "statusDestinacao"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "empresaGeradora": { "type": "string", "minLength": 1, "maxLength": 150 },
    "categoriaResiduo": {
      "type": "string",
      "enum": ["PLASTICO", "PAPEL_PAPELAO", "LIXO_ELETRONICO", "METAIS", "VIDRO"]
    },
    "pesoKg": { "type": "number", "exclusiveMinimum": 0 },
    "dataAgendamento": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "statusDestinacao": {
      "type": "string",
      "enum": ["AGENDADO", "EM_TRANSPORTE", "DESTINADO_CORRETAMENTE"]
    }
  }
}
