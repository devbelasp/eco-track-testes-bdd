{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Erro de validacao",
  "description": "Erro 400 de validacao: {\"erro\": \"Dados inválidos.\", \"campos\": {\"campo\": \"mensagem\"}}",
  "type": "object",
  "required": ["erro", "campos"],
  "additionalProperties": false,
  "properties": {
    "erro": { "type": "string", "enum": ["Dados inválidos."] },
    "campos": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
