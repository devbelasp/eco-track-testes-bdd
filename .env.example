# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ser enviado ao Git (ja esta no .gitignore).

# --- Banco de dados (usado pelo docker-compose) ---
POSTGRES_DB=ecotrack
POSTGRES_USER=ecotrack
POSTGRES_PASSWORD=troque-esta-senha

# --- Portas expostas no seu computador ---
APP_PORT=8080
DB_PORT=5432

# --- Testes BDD rodando FORA do Docker (mvn -f tests-bdd/pom.xml clean test) ---
# URL da API. Padrao: http://localhost:8080. Se mudar APP_PORT, ajuste aqui tambem.
# Exporte no terminal antes de rodar:  export BASE_URL=http://localhost:8080
# BASE_URL=http://localhost:8080
